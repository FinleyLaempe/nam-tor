  "async_design": {
    "mechanism": "QDBusInterface::asyncCall() + QDBusPendingCallWatcher",
    "gui_thread_blocking": false,
    "cancellation": "Generation counter bumped on cancel/restart; late replies dropped via gen != m_generation check",
    "stale_response_sequencing": "Each in-flight call captures the generation at issue time; the handler compares against the current generation and returns early on mismatch"
  },
  "rust_bridge": {
    "proxy": "zbus::proxy matching frozen contract (11 methods, 4 signals, 1 property)",
    "types": "ProfileInfo (ssbtt), EnrollmentProgress (susu), ReviewOutcome (sbs), StatusReport (ua(ssbtt)b)",
    "enrollment_controller": "Signal-driven (no poll); set_progress filters by session_id for stale-response sequencing; commit replaces finish; cancel is idempotent"
  },
