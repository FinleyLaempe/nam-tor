  "fixtures": {
    "arch": ["gdm-password", "sudo", "su", "polkit-1", "system-auth"],
    "fedora": ["password-auth", "sddm", "sudo", "su"],
    "debian": ["common-auth", "gdm-password", "sudo", "su", "polkit-1"]
  },
  "types": {
    "PamServiceInfo": "Wire type (ssbss): id, label, enabled, compatibility, reason — matches v2 D-Bus contract",
    "PamServiceCompatibility": "Enum: Safe, Unsupported, Risky — matches v2 contract",
    "ServiceStatus": "Combined 4-state: Enabled, Disabled, Unsupported, Risky — derived from enabled + compatibility"
  },
  "classification_rules": {
    "Enabled": "pam_namtor.so already present in auth stack",
    "Disabled": "not present, password fallback exists (pam_unix/pam_systemd_home/pam_env or include of common-auth/system-auth/password-auth), no pam_deny, no substack",
    "Unsupported": "no auth lines, or no password fallback, or sshd (PAM_RHOST refused)",
    "Risky": "has password fallback but also has pam_deny.so or substack directives"
  }
}
