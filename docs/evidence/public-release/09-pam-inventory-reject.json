    {"name": "scanner_skips_backup_files", "category": "scanner-reject", "status": "PASS", "asserts": "files ending with ~, .bak, .namtor.bak are skipped"},
    {"name": "scanner_skips_dotfiles", "category": "scanner-reject", "status": "PASS", "asserts": "dotfiles are skipped"},
    {"name": "scanner_skips_rpm_and_dpkg_save_files", "category": "scanner-reject", "status": "PASS", "asserts": ".rpmsave, .rpmnew, .rpmorig, .dpkg-dist, .dpkg-old, .dpkg-new skipped"},
    {"name": "scanner_does_not_scan_namtor_backup_files", "category": "scanner-reject", "status": "PASS", "asserts": ".namtor.bak and .namtor.bak.sha256 sidecars skipped"},
    {"name": "scanner_rejects_nonexistent_directory", "category": "scanner-reject", "status": "PASS", "asserts": "ScanError::NotADirectory for missing path"},
