  "rejection_rules": {
    "symlinks": "rejected via symlink_metadata check — security: never follow links in pam.d",
    "backups": "rejected by suffix: ~, .bak, .namtor.bak, .namtor.bak.sha256",
    "dotfiles": "rejected by leading dot",
    "rpm_save": "rejected: .rpmsave, .rpmnew, .rpmorig",
    "dpkg_save": "rejected: .dpkg-dist, .dpkg-old, .dpkg-new",
    "include_cycle": "detected via visited-set tracking in resolve_includes_inner",
    "directory_traversal": "rejected if include target contains .. or starts with /",
    "malformed": "rejected if file contains only comments/empty lines (no PAM entries)"
  }
