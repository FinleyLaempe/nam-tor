# SPDX-License-Identifier: GPL-3.0-only
[Unit]
Description=Nam-tor face authentication daemon
Documentation=man:namtor-daemon(8)
After=local-fs.target
Requires=namtor-daemon.socket

[Service]
Type=simple
User=namtor
Group=namtor
SupplementaryGroups=video tss
# The worker is the same executable re-exec'd as `namtor worker`; the daemon
# resolves it through /proc/self/exe. NAMTOR_WORKER_BIN is only the fallback
# for a /proc-less environment.
Environment=NAMTOR_WORKER_BIN=/usr/bin/namtor
ExecStart=/usr/bin/namtor daemon
# SIGKILL backstop: after TimeoutStopSec, systemd sends SIGKILL; ExecStopPost
# runs even then to force the emitter off (spec §4.10.2 G1.4).
ExecStopPost=/usr/bin/namtor emitter-off /dev/video2
TimeoutStopSec=2

# --- Privilege reduction ---------------------------------------------------
# The daemon is not root. It has no capabilities (bounding set empty, no
# ambient capabilities). NoNewPrivileges prevents any child from gaining
# privileges via setuid binaries. The worker is spawned directly as a
# child of the daemon (same user `namtor`, same executable re-exec'd as
# `namtor worker`) and self-applies seccomp + landlock — the sandbox is
# the privilege boundary, not a UID drop, and not a shared address space.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

# --- Filesystem isolation --------------------------------------------------
# ProtectSystem=strict makes the entire filesystem read-only except
# ReadWritePaths. The daemon may only write to its state directory.
# ProtectHome makes /home, /root, /run/user inaccessible.
# PrivateTmp gives the daemon a private /tmp.
# PrivateMounts gives the daemon a private mount namespace.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateMounts=true
ReadWritePaths=/var/lib/namtor

# --- Kernel hardening ------------------------------------------------------
# ProtectClock: blocks /dev/rtc, hwclock, system clock changes.
# ProtectKernelTunables: makes /proc/sys and /sys read-only.
# ProtectKernelModules: blocks init_module/fini_module syscalls.
# ProtectKernelLogs: restricts kernel log access (dmesg).
# ProtectControlGroups: makes /sys/fs/cgroup read-only.
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true

# --- Namespace restrictions ------------------------------------------------
RestrictNamespaces=true

# --- Process and IPC isolation ---------------------------------------------
# RemoveIPC: destroys SysV IPC objects owned by the service user on stop.
# ProtectProc=invisible: hides processes owned by other users in /proc.
# ProcSubset=pid: restricts /proc to PID-related entries only.
# ProtectHostname: prevents changing the system hostname/domainname.
RemoveIPC=true
ProtectProc=invisible
ProcSubset=pid
ProtectHostname=true

# --- Real-time and SUID/SGID restrictions ----------------------------------
# RestrictRealtime: blocks real-time scheduling (RLIMIT_RTPRIO = 0).
# RestrictSUIDSGID: blocks creation of setuid/setgid files.
RestrictRealtime=true
RestrictSUIDSGID=true

# --- Personality and architecture locking ----------------------------------
LockPersonality=true
SystemCallArchitectures=native

# --- Syscall filter --------------------------------------------------------
# @system-service is the systemd-recommended baseline for system services.
# It allows process management, file I/O, socket operations, and standard
# libc calls, while blocking module loading, kernel keyring, and other
# privileged syscall groups.
# NOTE: the worker child inherits these restrictions. ONNX Runtime CPU EP
# does not require W+X memory, so MemoryDenyWriteExecute is safe to add
# in the future once verified against the full model set.
SystemCallFilter=@system-service

# --- Network restrictions --------------------------------------------------
# The daemon only speaks AF_UNIX (PAM socket + worker socketpair).
# No networking whatsoever. IPAddressDeny=any is defense-in-depth on top
# of RestrictAddressFamilies — even if a future change widens the address
# family set, all IP traffic remains blocked.
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
