#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# namtor.postrm — Debian post-removal hook (debhelper compat 13).
#
# Delegates to the shared lifecycle helper (Task 19). Debian distinguishes
# `remove` (delete package files, keep user state for reinstall) from
# `purge` (delete everything). The package payload is gone by postrm, so
# the full-purge phases call the cached copy left by prerm.

set -e

NAMTOR_LIFECYCLE_CACHE=/var/tmp/namtor-lifecycle.sh

case "$1" in
    remove)
        # Light cleanup only — keep enrolled templates + PAM registry so the
        # user can reinstall without re-enrolling. tmpfiles --remove is
        # best-effort (the tmpfiles.d drop-in is already gone).
        if command -v systemd-tmpfiles >/dev/null 2>&1; then
            systemd-tmpfiles --remove /usr/lib/tmpfiles.d/namtor.conf 2>/dev/null || true
        fi
        ;;
    purge)
        "$NAMTOR_LIFECYCLE_CACHE" post-remove || true
        rm -f "$NAMTOR_LIFECYCLE_CACHE" 2>/dev/null || true
        ;;
    upgrade|failed-upgrade)
        /usr/share/namtor/lifecycle.sh post-upgrade || true
        ;;
    abort-install|disappear)
        ;;
    *)
        echo "namtor.postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
