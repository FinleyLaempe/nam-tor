#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# namtor.prerm — Debian pre-removal hook (debhelper compat 13).
#
# Delegates to the shared lifecycle helper (Task 19). On removal: pre-remove
# (disable-all PAM + stop daemon) and cache the helper so postrm can still
# run after dpkg deletes the payload. On upgrade: pre-upgrade (snapshot PAM).

set -e

NAMTOR_LIFECYCLE_CACHE=/var/tmp/namtor-lifecycle.sh

case "$1" in
    remove)
        /usr/share/namtor/lifecycle.sh pre-remove || true
        cp -f /usr/share/namtor/lifecycle.sh "$NAMTOR_LIFECYCLE_CACHE" 2>/dev/null || true
        ;;
    upgrade|deconfigure|failed-upgrade)
        /usr/share/namtor/lifecycle.sh pre-upgrade || true
        ;;
    *)
        echo "namtor.prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
