#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# namtor.postinst — Debian post-install hook (debhelper compat 13).
#
# Delegates validation + service enablement to the shared lifecycle helper
# at /usr/share/namtor/lifecycle.sh (Task 19). PAM is default-off: the
# helper never edits /etc/pam.d in post-install. On upgrade ($2 set to the
# old version) the helper runs post-upgrade (migrate + re-validate).

set -e

case "$1" in
    configure)
        if [ -n "$2" ]; then
            /usr/share/namtor/lifecycle.sh post-upgrade --version "$2" || true
        else
            if ! /usr/share/namtor/lifecycle.sh post-install; then
                echo ":: namtor: post-install mandatory checks failed — see FATAL lines above." >&2
                exit 1
            fi
            cat <<'EOF'

:: namtor installed. PAM services are OFF by default.
   To complete setup:
     1. Open the Nam-tor Settings app.
     2. Enroll your face.
     3. Choose which PAM services to enable (e.g. gdm-password).
   No CLI or root shell needed for setup.
EOF
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "namtor.postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# dh_installdeb will replace this with debhelper's generated content.
#DEBHELPER#

exit 0
