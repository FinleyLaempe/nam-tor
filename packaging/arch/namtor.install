# SPDX-License-Identifier: GPL-3.0-only
# namtor.install — pacman lifecycle hooks for the namtor package.
#
# Delegates every phase to the shared, package-independent lifecycle helper
# at /usr/share/namtor/lifecycle.sh (Task 19). The helper is typed:
# pre-install, post-install, pre-upgrade, post-upgrade, pre-remove,
# post-remove. It validates model layout/hashes, identities/dirs, socket and
# D-Bus services, and drives `namtor-pam-edit` for snapshot/migrate/
# disable-all/purge. PAM is default-off at install time: post-install never
# edits /etc/pam.d.
#
# pacman deletes payload files BEFORE post_remove runs, so pre_remove caches
# the helper to /var/tmp where post_remove can still invoke it.

NAMTOR_LIFECYCLE_CACHE=/var/tmp/namtor-lifecycle.sh

post_install() {
    if ! /usr/share/namtor/lifecycle.sh post-install --version "${pkgver:-}"; then
        echo ":: namtor: post-install mandatory checks failed — see FATAL lines above." >&2
        return 1
    fi
    cat <<'EOF'

:: namtor installed. PAM services are OFF by default.
   To complete setup:
     1. Open the Nam-tor Settings app.
     2. Enroll your face.
     3. Choose which PAM services to enable (e.g. gdm-password).
   No CLI or root shell needed for setup.
   Remove:  sudo pacman -Rns namtor
EOF
}

pre_upgrade() {
    /usr/share/namtor/lifecycle.sh pre-upgrade --version "${pkgver:-}" || true
}

post_upgrade() {
    /usr/share/namtor/lifecycle.sh post-upgrade --version "${pkgver:-}" || true
}

pre_remove() {
    /usr/share/namtor/lifecycle.sh pre-remove || true
    # Cache the helper so post_remove can run after pacman deletes the payload.
    cp -f /usr/share/namtor/lifecycle.sh "$NAMTOR_LIFECYCLE_CACHE" 2>/dev/null || true
}

post_remove() {
    "$NAMTOR_LIFECYCLE_CACHE" post-remove || true
    rm -f "$NAMTOR_LIFECYCLE_CACHE" 2>/dev/null || true
}
