# SPDX-License-Identifier: GPL-3.0-only
# namtor.install — pacman pre/post install hooks for the namtor package.
#
# Turnkey: models bundled (BSD-3 auto-accepted), sysusers/tmpfiles/DM
# group/PAM/socket all handled automatically.

post_install() {
    echo ":: namtor: registering system user + runtime dirs"
    if command -v systemd-sysusers >/dev/null 2>&1; then
        systemd-sysusers /usr/lib/sysusers.d/namtor.conf || true
    fi
    if command -v systemd-tmpfiles >/dev/null 2>&1; then
        systemd-tmpfiles --create /usr/lib/tmpfiles.d/namtor.conf || true
    fi

    if [[ -f /usr/lib/namtor/namtor-worker-spawn ]]; then
        chmod u+s /usr/lib/namtor/namtor-worker-spawn
    fi

    chown -R namtor:namtor /var/lib/namtor/ 2>/dev/null || true

    for dm in gdm sddm lightdm lxdm; do
        if id "$dm" >/dev/null 2>&1; then
            gpasswd -a "$dm" namtor-auth 2>/dev/null || true
        fi
    done

    if [[ -x /usr/share/namtor/pam-install.sh ]]; then
        /usr/share/namtor/pam-install.sh || echo ":: namtor: PAM install skipped — run: sudo /usr/share/namtor/pam-install.sh"
    fi

    systemctl enable --now namtor-daemon.socket 2>/dev/null || true

    echo ""
    echo ":: namtor installed and running."
    echo "   Enroll your face:  namtor-cli enroll <username>"
    echo "   Test auth:         namtor-cli verify --user <username>"
    echo ""
    echo "   Remove:  sudo pacman -Rns namtor"
}

post_upgrade() {
    post_install
}

pre_remove() {
    echo ":: namtor: removing PAM integration (if installed)"
    if [[ -x /usr/share/namtor/pam-uninstall.sh ]]; then
        /usr/share/namtor/pam-uninstall.sh --restore-backup || true
    fi
    echo ":: namtor: stopping daemon"
    systemctl --no-reload disable --now namtor-daemon.socket namtor-daemon.service 2>/dev/null || true
}

post_remove() {
    echo ":: namtor: cleaning runtime dirs"
    if command -v systemd-tmpfiles >/dev/null 2>&1; then
        systemd-tmpfiles --remove /usr/lib/tmpfiles.d/namtor.conf || true
    fi
    rm -rf /var/lib/namtor /run/namtor
}
