# SPDX-License-Identifier: GPL-3.0-only
# Maintainer: Nam-tor Project <https://github.com/namtor/nam-tor>
#
# Arch Linux SPLIT package for Nam-tor — IR face authentication.
#
# pkgbase=namtor builds three packages from one PKGBUILD:
#
#   namtor       — core: daemon, worker, CLI, PAM module, systemd units,
#                  sysusers, tmpfiles, D-Bus, polkit, manifests, models,
#                  licences, lifecycle helper, SBOM. Headless-safe (no
#                  desktop deps).
#   namtor-gnome — GTK4/libadwaita enrollment wizard + settings. Desktop
#                  entry, metainfo, icon. Depends on namtor exact version.
#   namtor-kde   — Plasma 6 KCM QML module + desktop entry, metainfo,
#                  icon. Depends on namtor exact version.
#
# The install manifest (schema v2) carries per-entry `package` ownership
# (core|gnome|kde). stage.sh --package core|gnome|kde stages only the
# entries owned by that package, producing a deterministic DESTDIR layout
# with no file conflicts between packages.
#
# Supported architectures: x86_64, aarch64 (matches model-manifest.toml
# `target_arch = "both"` for YuNet/SFace/MiniFASNet).
#
# Runtime deps (per package):
#   namtor       — onnxruntime (CPU EP), systemd, pam, gcc-libs
#   namtor-gnome — namtor=$pkgver (exact), gtk4, libadwaita
#   namtor-kde   — namtor=$pkgver (exact), qt6-base, kirigami, kcoreaddons
#
# Models are bundled: YuNet (MIT, redistributable), SFace (Apache-2.0,
# redistributable), and MiniFASNet (self-trained, Apache-2.0). Licence
# records are pre-written so the daemon starts with zero manual steps.
#
# The model archive (namtor-models-$pkgver.tar.gz) is the deterministic,
# reproducible, signed source of truth produced by
# packaging/build-model-archive.sh. It is MANDATORY: this recipe refuses to
# build without it, and prepare() verifies its MANIFEST.json + sha256 sidecar
# before any compilation starts. No network fetch occurs at build or install
# time. Repeated archive builds produce an identical SHA-256
# (d1ac6c53fd14d08de3cc58c8cce84c020513ee2f34ca419ce5f6055284923f92 for
# 0.1.0); the hash below is regenerated by the release workflow when the
# archive is rebuilt.

pkgbase=namtor
pkgname=(
    namtor
    namtor-gnome
    namtor-kde
)
pkgver=0.1.0
pkgrel=1
epoch=0
arch=('x86_64' 'aarch64')
url="https://github.com/namtor/nam-tor"
license=('GPL-3.0-only' 'MIT' 'Apache-2.0')
groups=()
checkdepends=('cargo')
optdepends=()
backup=()
validpgpkeys=()
# Release profile already strips; debug symbols not shipped.
options=('!strip' '!debug')
changelog=

# All makedeps are at the pkgbase level — every crate is built in one
# `cargo build` pass, and the KDE KCM needs CMake + Qt6 + KF6 frameworks.
makedepends=(
    'cargo'
    'rust'
    'python>=3.11'
    'cmake'
    'qt6-base'
    'kirigami'
    'kcoreaddons'
    'extra-cmake-modules'
)

source=("namtor-$pkgver.tar.gz" "namtor-models-$pkgver.tar.gz")
noextract=()
# Real sha256 — no SKIP. The model archive hash is reproducible
# (build-model-archive.sh yields a byte-identical tarball every build). The
# source tarball hash is pinned at release time by the release workflow.
sha256sums=(
    '19c93d0498b91e81f8148a3d27b515e2db87bb3d98eaf12143466f6266bf5a3e'
    'aba53c49acffb7cedf55296dfb84b1c39005243f194ce56071dd1bf6de0760cf'
)

# ---------------------------------------------------------------------------
# prepare: verify Cargo.lock + the mandatory model archive. The archive
# (namtor-models-$pkgver.tar.gz) is verified by build-model-archive.sh
# --verify, which checks MANIFEST.json + sha256 sidecar + per-model hashes
# against packaging/model-manifest.toml. Fails closed if absent or tampered
# — no build proceeds without a verified model source.
# ---------------------------------------------------------------------------
prepare() {
    cd "$srcdir/nam-tor-$pkgver"
    if [[ ! -f Cargo.lock ]]; then
        echo "error: Cargo.lock missing — release tarballs must ship a lockfile" >&2
        return 1
    fi
    local archive="$srcdir/namtor-models-$pkgver.tar.gz"
    if [[ ! -f "$archive" ]]; then
        echo "error: model archive missing — namtor-models-$pkgver.tar.gz is mandatory" >&2
        return 1
    fi
    ./packaging/build-model-archive.sh --verify "$archive" "$srcdir/nam-tor-$pkgver"
    cargo --version
}

# ---------------------------------------------------------------------------
# build: cargo build --release for all install-manifest binaries + PAM
# cdylib, then the KDE KCM QML module (CMake build). Shared across all
# three split packages — makepkg runs build() once.
# ---------------------------------------------------------------------------
build() {
    cd "$srcdir/nam-tor-$pkgver"
    # ring 0.17.x C/asm code fails to link when GCC LTO (-flto=auto, set by
    # makepkg.conf OPTIONS+=lto) produces LLVM bitcode that rust-lld cannot
    # ingest. Strip -flto* from CFLAGS/LDFLAGS so ring's build.rs emits
    # regular object files. Rust LTO (lto=true in Cargo.toml [profile.release])
    # is unaffected — it is a separate, linker-internal pass.
    export CFLAGS="${CFLAGS// -flto=auto/}"
    export CFLAGS="${CFLAGS//-flto=auto/}"
    export LDFLAGS="${LDFLAGS// -flto=auto/}"
    export LDFLAGS="${LDFLAGS//-flto=auto/}"
    # Build every artifact the install manifest references. -p pins avoid
    # pulling unrelated workspace members (e.g. namtor-eval, namtor-probe).
    cargo build --release --frozen \
        -p namtor-daemon \
        -p namtor-worker \
        -p namtor-cli \
        -p namtor-camera \
        -p namtor-pam \
        -p namtor-gnome \
        -p namtor-kde

    # KDE KCM QML module (CMake build — installs libnamtorqml.so + main.qml +
    # metadata.json into the Qt6 QML import dir). The Rust cdylib
    # (libnamtor_kde.so) is built by cargo above and linked by CMake.
    local _rust_so="$srcdir/nam-tor-$pkgver/target/release/libnamtor_kde.so"
    cmake -S "$srcdir/nam-tor-$pkgver/crates/namtor-kde" \
        -B build-kde \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DNAMTOR_KDE_RUST_SO="$_rust_so"
    cmake --build build-kde --parallel
}

# ---------------------------------------------------------------------------
# check: workspace tests (skipping the known-flaky serialise test)
# ---------------------------------------------------------------------------
check() {
    cd "$srcdir/nam-tor-$pkgver"
    cargo test --workspace -- --skip concurrent_connections_serialise --test-threads=1
}

# ---------------------------------------------------------------------------
# package_namtor: core package — daemon, worker, CLI, PAM, systemd, models,
# licences, lifecycle helper, SBOM. Headless-safe (no desktop deps).
# ---------------------------------------------------------------------------
package_namtor() {
    pkgdesc="IR face authentication — daemon, PAM module, CLI, models (headless-safe)"
    arch=('x86_64' 'aarch64')
    depends=(
        'onnxruntime'
        'pam'
        'systemd'
        'gcc-libs'
    )
    provides=('pam_namtor')
    conflicts=()
    replaces=()
    install=namtor.install

    cd "$srcdir/nam-tor-$pkgver"

    # Deterministic staging from packaging/install-manifest.toml — core
    # entries only (daemon, worker, CLI, PAM, systemd, sysusers, tmpfiles,
    # D-Bus, polkit, manifests, PAM scripts, README, COPYING, SBOM,
    # lifecycle helper).
    ./packaging/stage.sh "$pkgdir" "$srcdir/nam-tor-$pkgver" --package core

    # Bundle models (MIT: YuNet; Apache-2.0: SFace; self-trained: MiniFASNet)
    mkdir -p "$pkgdir/var/lib/namtor/models"
    cp "$srcdir/models/yunet_2023mar.onnx" "$pkgdir/var/lib/namtor/models/"
    cp "$srcdir/models/sface_2021dec.onnx" "$pkgdir/var/lib/namtor/models/"
    cp "$srcdir/models/minifasnet_pad.onnx" "$pkgdir/var/lib/namtor/models/"

    # Worker expects <root>/<id>/<quant>.onnx
    mkdir -p "$pkgdir/var/lib/namtor/models/yunet_2023mar"
    ln -s ../yunet_2023mar.onnx "$pkgdir/var/lib/namtor/models/yunet_2023mar/fp32.onnx"
    mkdir -p "$pkgdir/var/lib/namtor/models/sface_2021dec"
    ln -s ../sface_2021dec.onnx "$pkgdir/var/lib/namtor/models/sface_2021dec/fp32.onnx"

    # Pre-write licence acceptance records (MIT/Apache-2.0 = permissive,
    # auto-accepted). SHA-256 arrays match packaging/model-manifest.toml.
    echo '{"model_id":"yunet_2023mar","licence_url":"https://raw.githubusercontent.com/opencv/opencv_zoo/main/models/face_detection_yunet/LICENSE","licence_sha256":[200,59,129,32,197,12,203,212,196,249,110,223,83,20,27,221,86,110,187,143,142,146,39,228,21,50,106,161,177,171,169,88],"accepted_at_us":0,"accepted_by":"package"}' \
        > "$pkgdir/var/lib/namtor/models/yunet_2023mar/licence.accepted"
    echo '{"model_id":"sface_2021dec","licence_url":"https://www.apache.org/licenses/LICENSE-2.0.txt","licence_sha256":[207,199,116,155,150,246,59,211,28,60,66,181,196,113,191,117,104,20,5,62,132,124,16,243,235,0,52,23,188,82,61,48],"accepted_at_us":0,"accepted_by":"package"}' \
        > "$pkgdir/var/lib/namtor/models/sface_2021dec/licence.accepted"
}

# ---------------------------------------------------------------------------
# package_namtor_gnome: GTK4/libadwaita enrollment wizard + settings.
# Depends on the exact core version. No Qt/KDE deps. No install hook —
# pacman's alpm hooks (desktop-database.hook, gtk-icon-cache.hook) handle
# .desktop/icon cache updates automatically after the transaction.
# ---------------------------------------------------------------------------
package_namtor-gnome() {
    pkgdesc="Nam-tor GNOME enrollment wizard and settings (GTK4/libadwaita)"
    arch=('x86_64' 'aarch64')
    depends=(
        "namtor=$pkgver"
        'gtk4'
        'libadwaita'
    )
    provides=()
    conflicts=()
    replaces=()
    # No install hook — desktop packages have no lifecycle hooks. The core
    # package's namtor.install delegates to the shared lifecycle helper.

    cd "$srcdir/nam-tor-$pkgver"

    # Deterministic staging from packaging/install-manifest.toml — gnome
    # entries only (enroll-wizard binary, .desktop, .metainfo.xml, .svg).
    ./packaging/stage.sh "$pkgdir" "$srcdir/nam-tor-$pkgver" --package gnome
}

# ---------------------------------------------------------------------------
# package_namtor_kde: Plasma 6 KCM QML module + desktop integration files.
# Depends on the exact core version. No GTK/libadwaita deps. No install
# hook — pacman's alpm hooks handle .desktop/icon cache updates.
# ---------------------------------------------------------------------------
package_namtor-kde() {
    pkgdesc="Nam-tor KDE Plasma 6 KCM — system settings module (Qt6/KF6)"
    arch=('x86_64' 'aarch64')
    depends=(
        "namtor=$pkgver"
        'qt6-base'
        'kirigami'
        'kcoreaddons'
    )
    provides=()
    conflicts=()
    replaces=()
    # No install hook — desktop packages have no lifecycle hooks.

    cd "$srcdir/nam-tor-$pkgver"

    # KDE KCM: install the CMake-built QML module + metadata.json into
    # $pkgdir. This installs libnamtorqml.so + main.qml into the Qt6 QML
    # import dir, and metadata.json into the kpackage/kcms dir. CMake also
    # installs the desktop/metainfo/icon files; stage.sh --package kde
    # below overwrites those with identical content from the manifest
    # (same source files — deterministic staging is the source of truth).
    DESTDIR="$pkgdir" cmake --install build-kde

    # Deterministic staging from packaging/install-manifest.toml — kde
    # entries only (kcm .desktop, .metainfo.xml, .svg).
    ./packaging/stage.sh "$pkgdir" "$srcdir/nam-tor-$pkgver" --package kde
}
