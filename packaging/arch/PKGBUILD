# SPDX-License-Identifier: GPL-3.0-only
# Maintainer: Nam-tor Project <https://github.com/FinleyLaempe/nam-tor>
#
# Arch Linux SPLIT package for Nam-tor — IR face authentication.
#
# pkgbase=namtor builds two packages from one PKGBUILD:
#
#   namtor       — core: daemon, worker, CLI, PAM module, systemd units,
#                  sysusers, tmpfiles, D-Bus, polkit, manifests, models,
#                  man pages, licences, lifecycle helper, SBOM. Headless-safe
#                  (no desktop deps).
#   namtor-ui    — GTK4/libadwaita enrollment wizard + settings. Desktop
#                  entry, metainfo, icon. Depends on namtor exact version.
#                  Desktop-neutral: it is the only UI.
#
# Two predecessors are obsoleted here rather than simply dropped:
#
#   namtor-gnome — the same package under its old, desktop-specific name,
#                  shipped up to and including 0.1.0-4. pacman does not
#                  migrate a rename on its own, so without the
#                  `provides`/`conflicts`/`replaces` below the old package
#                  lingers and FILE-CONFLICTS with this one: both own
#                  /usr/bin/namtor-enroll-wizard, the .desktop, the
#                  metainfo and the icon.
#   namtor-kde   — the Plasma 6 KCM, shipped up to and including 0.1.0-3,
#                  removed when the project consolidated on one
#                  desktop-neutral GTK4 UI. A leftover namtor-kde carries
#                  `depends=("namtor=$pkgver")` and pacman would otherwise
#                  refuse to upgrade the core package while that
#                  unsatisfiable dependency remained installed.
#
# An obsoletion only fires on an upgrade to a NEWER version, which is why
# pkgrel is bumped alongside the rename.
#
# The install manifest (schema v2) carries per-entry `package` ownership
# (core|ui). stage.sh --package core|ui stages only the entries owned
# by that package, producing a deterministic DESTDIR layout with no file
# conflicts between packages.
#
# Supported architectures: x86_64, aarch64 (matches model-manifest.toml
# `target_arch = "both"` for YuNet/SFace/MiniFASNet).
#
# Runtime deps (per package):
#   namtor       — onnxruntime (CPU EP), systemd, pam, gcc-libs
#   namtor-ui    — namtor=$pkgver (exact), gtk4, libadwaita
#
# Models are bundled: YuNet (MIT, redistributable), SFace (Apache-2.0,
# redistributable), and MiniFASNet (self-trained, Apache-2.0). Licence
# records are pre-written so the daemon starts with zero manual steps.
#
# The model archive (namtor-models-$_modelver.tar.gz) is the deterministic,
# reproducible, signed source of truth produced by
# packaging/build-model-archive.sh. It is MANDATORY: this recipe refuses to
# build without it, and prepare() verifies its MANIFEST.json + sha256 sidecar
# before any compilation starts. No network fetch occurs at build or install
# time. Repeated archive builds produce an identical SHA-256
# (d1ac6c53fd14d08de3cc58c8cce84c020513ee2f34ca419ce5f6055284923f92 for
# 0.1.0); the hash below is regenerated by the release workflow when the
# archive is rebuilt.

pkgbase=namtor
pkgname=(
    namtor
    namtor-ui
)
pkgver=0.3.7
pkgrel=1
epoch=0
arch=('x86_64' 'aarch64')
url="https://github.com/FinleyLaempe/nam-tor"
license=('GPL-3.0-only' 'MIT' 'Apache-2.0')
groups=()
checkdepends=('cargo')
# tpm2-tools is optional because the software fallback is a supported
# mode, but without it hardware-backed sealing is simply unavailable:
# namtor_store::Tpm2Backend shells out to the `tpm2` dispatcher, and
# `which_tpm2` fails with "tpm2-tools not on PATH". Nothing declared it
# anywhere, so every install silently sealed templates with a software
# key while the settings app reported "Software (fallback)" for a reason
# the user had no way to act on.
optdepends=('tpm2-tools: hardware-backed template sealing (TPM2); without it templates are sealed with a software key')
backup=()
validpgpkeys=()
# Release profile already strips; debug symbols not shipped.
# !zipman: man pages stay uncompressed so the installed paths match
# packaging/install-manifest.toml byte for byte. The manifest is the single
# source of truth for what lands on disk, and packaging/uninstall.sh removes
# exactly the paths it declares — a makepkg-gzipped .8.gz would not match.
options=('!strip' '!debug' '!zipman')
changelog=

# All makedeps are at the pkgbase level — every crate is built in one
# `cargo build` pass.
makedepends=(
    'cargo'
    'rust'
    'python>=3.11'
)

# The model archive version is deliberately INDEPENDENT of pkgver. The ONNX
# weights are their own artefact with their own release cadence: they are
# published once as a standing asset (models-v0.1.0) and are unchanged by a
# source-only release. Coupling them to $pkgver meant the first version bump
# made makepkg look for namtor-models-0.2.0.tar.gz, which does not and should
# not exist. packaging/build-model-archive.sh already defaults to 0.1.0 and
# packaging/debian/rules already hardcoded it; this makes Arch agree.
_modelver=0.1.0
source=("namtor-$pkgver.tar.gz" "namtor-models-$_modelver.tar.gz")
noextract=()
# Real sha256 — no SKIP. The model archive hash is reproducible
# (build-model-archive.sh yields a byte-identical tarball every build). The
# source tarball hash is pinned at release time by the release workflow.
sha256sums=(
    '121d51354fe052c922ebb2aaa361e3367f555f09e40b4ee16964e1db1fd1157e'
    '7bc800dea9d4b1eb5ce5dabc8c5197aeac81482ac80e3fcd27f0f71879a803be'
)

# ---------------------------------------------------------------------------
# prepare: verify Cargo.lock + the mandatory model archive. The archive
# (namtor-models-$_modelver.tar.gz) is verified by build-model-archive.sh
# --verify, which checks MANIFEST.json + sha256 sidecar + per-model hashes
# against packaging/model-manifest.toml. Fails closed if absent or tampered
# — no build proceeds without a verified model source.
# ---------------------------------------------------------------------------
prepare() {
    cd "$srcdir/nam-tor-$pkgver"
    if [[ ! -f Cargo.lock ]]; then
        echo "error: Cargo.lock missing — release tarballs must ship a lockfile" >&2
        return 1
    fi
    local archive="$srcdir/namtor-models-$_modelver.tar.gz"
    if [[ ! -f "$archive" ]]; then
        echo "error: model archive missing — namtor-models-$_modelver.tar.gz is mandatory" >&2
        return 1
    fi
    ./packaging/build-model-archive.sh --verify "$archive" "$srcdir/nam-tor-$pkgver"
    cargo --version
}

# ---------------------------------------------------------------------------
# build: cargo build --release for all install-manifest binaries + PAM
# cdylib. Shared across both split packages — makepkg runs build() once.
# ---------------------------------------------------------------------------
build() {
    cd "$srcdir/nam-tor-$pkgver"
    # ring 0.17.x C/asm code fails to link when GCC LTO (-flto=auto, set by
    # makepkg.conf OPTIONS+=lto) produces LLVM bitcode that rust-lld cannot
    # ingest. Strip -flto* from CFLAGS/LDFLAGS so ring's build.rs emits
    # regular object files. Rust LTO (lto=true in Cargo.toml [profile.release])
    # is unaffected — it is a separate, linker-internal pass.
    export CFLAGS="${CFLAGS// -flto=auto/}"
    export CFLAGS="${CFLAGS//-flto=auto/}"
    export LDFLAGS="${LDFLAGS// -flto=auto/}"
    export LDFLAGS="${LDFLAGS//-flto=auto/}"
    # Build every artifact the install manifest references. -p pins avoid
    # pulling unrelated workspace members (e.g. namtor-eval, namtor-probe).
    cargo build --release --locked --offline \
        -p namtor \
        -p namtor-pam \
        -p namtor-ui
}

# ---------------------------------------------------------------------------
# check: workspace tests. `--test-threads=1` serialises tests that mutate
# process-global env vars (the licence tests set/remove NAMTOR_ACCEPT_LICENCE);
# without it those races produce spurious failures.
# ---------------------------------------------------------------------------
check() {
    cd "$srcdir/nam-tor-$pkgver"
    cargo test --workspace -- --test-threads=1
}

# ---------------------------------------------------------------------------
# package_namtor: core package — the single `namtor` multi-call binary
# (daemon, worker, CLI, emitter-off), PAM module, systemd, models, licences,
# lifecycle helper, SBOM. Headless-safe (no desktop deps).
# ---------------------------------------------------------------------------
package_namtor() {
    pkgdesc="IR face authentication — single namtor binary (daemon/worker/CLI), PAM module, models (headless-safe)"
    arch=('x86_64' 'aarch64')
    depends=(
        'onnxruntime'
        'pam'
        'systemd'
        'gcc-libs'
    )
    provides=('pam_namtor')
    conflicts=()
    replaces=()
    install=namtor.install

    cd "$srcdir/nam-tor-$pkgver"

    # Deterministic staging from packaging/install-manifest.toml — core
    # entries only (namtor binary + namtor-cli symlink, PAM, systemd, sysusers, tmpfiles,
    # D-Bus, polkit, manifests, man pages, PAM scripts, README, COPYING,
    # SBOM, lifecycle helper).
    ./packaging/stage.sh "$pkgdir" "$srcdir/nam-tor-$pkgver" --package core

    # Man pages come from the manifest (docs/man/namtor-daemon.8 and
    # docs/man/pam_namtor.8 -> /usr/share/man/man8, docs/man/namtor-cli.1 ->
    # /usr/share/man/man1). `Documentation=man:namtor-daemon(8)` in the
    # shipped units only resolves if they are actually installed —
    # `systemd-analyze verify` shells out to man(1) and exits 1 with
    # `Protocol error` otherwise. pam_namtor.8 is not a Documentation= target
    # but namtor-daemon.8 cross-references it, and a dangling cross-reference
    # is a lintian finding on the Debian side.
    test -f "$pkgdir/usr/share/man/man8/namtor-daemon.8" || {
        echo "error: man8/namtor-daemon.8 not staged" >&2; return 1; }
    test -f "$pkgdir/usr/share/man/man8/pam_namtor.8" || {
        echo "error: man8/pam_namtor.8 not staged" >&2; return 1; }
    test -f "$pkgdir/usr/share/man/man1/namtor-cli.1" || {
        echo "error: man1/namtor-cli.1 not staged" >&2; return 1; }

    # Bundle models (MIT: YuNet; Apache-2.0: SFace; self-trained: MiniFASNet)
    mkdir -p "$pkgdir/var/lib/namtor/models"
    cp "$srcdir/models/yunet_2023mar.onnx" "$pkgdir/var/lib/namtor/models/"
    cp "$srcdir/models/sface_2021dec.onnx" "$pkgdir/var/lib/namtor/models/"
    cp "$srcdir/models/minifasnet_pad.onnx" "$pkgdir/var/lib/namtor/models/"

    # Worker expects <root>/<id>/<quant>.onnx
    mkdir -p "$pkgdir/var/lib/namtor/models/yunet_2023mar"
    ln -s ../yunet_2023mar.onnx "$pkgdir/var/lib/namtor/models/yunet_2023mar/fp32.onnx"
    mkdir -p "$pkgdir/var/lib/namtor/models/sface_2021dec"
    ln -s ../sface_2021dec.onnx "$pkgdir/var/lib/namtor/models/sface_2021dec/fp32.onnx"

    # Pre-write licence acceptance records (MIT/Apache-2.0 = permissive,
    # auto-accepted). SHA-256 arrays match packaging/model-manifest.toml.
    echo '{"model_id":"yunet_2023mar","licence_url":"https://raw.githubusercontent.com/opencv/opencv_zoo/main/models/face_detection_yunet/LICENSE","licence_sha256":[200,59,129,32,197,12,203,212,196,249,110,223,83,20,27,221,86,110,187,143,142,146,39,228,21,50,106,161,177,171,169,88],"accepted_at_us":0,"accepted_by":"package"}' \
        > "$pkgdir/var/lib/namtor/models/yunet_2023mar/licence.accepted"
    echo '{"model_id":"sface_2021dec","licence_url":"https://www.apache.org/licenses/LICENSE-2.0.txt","licence_sha256":[207,199,116,155,150,246,59,211,28,60,66,181,196,113,191,117,104,20,5,62,132,124,16,243,235,0,52,23,188,82,61,48],"accepted_at_us":0,"accepted_by":"package"}' \
        > "$pkgdir/var/lib/namtor/models/sface_2021dec/licence.accepted"
}

# ---------------------------------------------------------------------------
# package_namtor-ui: GTK4/libadwaita enrollment wizard + settings — the
# single, desktop-neutral UI. Depends on the exact core version. No install
# hook — pacman's alpm hooks (desktop-database.hook, gtk-icon-cache.hook)
# handle .desktop/icon cache updates automatically after the transaction.
#
# `provides`/`conflicts`/`replaces` are an UPGRADE BLOCKER FIX, not
# tidiness:
#
# - namtor-gnome is this package's former name. pacman migrates nothing on
#   a rename: without `replaces` the old package stays installed and
#   file-conflicts with this one on all four of its files, and the install
#   fails. `provides` keeps anything that depended on the old name
#   satisfiable during the transaction; `conflicts` makes the overlap
#   explicit rather than letting pacman discover it file by file.
# - namtor-kde declared depends=("namtor=$pkgver"); once it stops being
#   built, a machine that still has it installed has an unsatisfiable
#   dependency and pacman aborts the whole transaction rather than
#   upgrading the core package.
#
# Do not drop either until no supported upgrade path starts from a release
# that shipped them (namtor-kde <= 0.1.0-3, namtor-gnome <= 0.1.0-4).
# ---------------------------------------------------------------------------
package_namtor-ui() {
    pkgdesc="Nam-tor enrollment wizard and settings (GTK4/libadwaita)"
    arch=('x86_64' 'aarch64')
    depends=(
        "namtor=$pkgver"
        'gtk4'
        'libadwaita'
    )
    provides=('namtor-gnome')
    conflicts=('namtor-gnome' 'namtor-kde')
    replaces=('namtor-gnome' 'namtor-kde')
    # No install hook — desktop packages have no lifecycle hooks. The core
    # package's namtor.install delegates to the shared lifecycle helper.

    cd "$srcdir/nam-tor-$pkgver"

    # Deterministic staging from packaging/install-manifest.toml — UI
    # entries only (enroll-wizard binary, .desktop, .metainfo.xml, .svg).
    ./packaging/stage.sh "$pkgdir" "$srcdir/nam-tor-$pkgver" --package ui
}
