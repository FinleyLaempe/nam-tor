# SPDX-License-Identifier: GPL-3.0-only
# Desktop entry for the Nam-tor KDE KCM (Plasma 6 System Settings module).
#
# Installed to /usr/share/applications/org.namtor.kcm.desktop.
# KDE Plasma's System Settings search and kcmshell6 use this to discover
# and launch the KCM standalone. The Keywords field feeds Settings/Shell
# search so the module is findable by "face", "authentication", etc.
#
# The KCM itself is discovered inside System Settings via metadata.json
# (KPlugin JSON, installed to the kpackage/kcms directory). This desktop
# entry covers standalone launch from the application menu / krunner.

[Desktop Entry]
Type=Application
Name=Nam-tor Face Authentication
Name[de]=Nam-tor Gesichtserkennung
GenericName=Face Authentication
Comment=Enroll and manage infrared face authentication profiles
Comment[de]=Gesichtsprofile für die Anmeldung anlegen und verwalten
Exec=kcmshell6 kcm_namtor
Icon=org.namtor.kcm
Terminal=false
Categories=Settings;DesktopSettings;KDE;Qt;
Keywords=face;authentication;biometric;login;camera;ir;infrared;namtor;
Keywords[de]=gesicht;authentifizierung;biometrie;anmeldung;kamera;infrarot;namtor;
StartupNotify=false
NoDisplay=true
