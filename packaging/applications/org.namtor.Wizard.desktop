# SPDX-License-Identifier: GPL-3.0-only
# Desktop entry for the Nam-tor management UI.
#
# Installed to /usr/share/applications/org.namtor.Wizard.desktop.
# Desktop shells and their application search use this to discover and
# launch the enrollment wizard. The Keywords field feeds that search so the
# app is findable by "face", "authentication", "biometric", etc.
#
# The application ID (org.namtor.Wizard) is `namtor_ui::APP_ID`, used by
# the gtk4 Application constructed in crates/namtor-ui/src/bin/wizard.rs,
# so the desktop entry and the running process share a D-Bus
# window-activation path. It is ABI: it does not track the crate name.

[Desktop Entry]
Type=Application
Name=Nam-tor Face Profiles
GenericName=Face Authentication
Comment=Enroll and manage infrared face authentication profiles
Comment[de]=Gesichts-Authentifizierungsprofile verwalten
Exec=namtor-enroll-wizard
Icon=org.namtor.Wizard
Terminal=false
Categories=Settings;Security;GTK;
Keywords=face;authentication;biometric;iris;infrared;login;security;namtor;
StartupNotify=true
StartupWMClass=org.namtor.Wizard
