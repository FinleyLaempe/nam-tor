# Desktop entry for the Nam-tor GNOME management UI.
#
# Installed to /usr/share/applications/org.namtor.Wizard.desktop.
# GNOME Shell and the Activities search use this to discover and launch
# the enrollment wizard. The Keywords field feeds Settings/Shell search
# so the app is findable by "face", "authentication", "biometric", etc.
#
# The application ID (org.namtor.Wizard) matches the gtk4 Application
# constructed in crates/namtor-gnome/src/bin/wizard.rs so the desktop
# entry and the running process share a D-Bus window-activation path.

[Desktop Entry]
Type=Application
Name=Nam-tor Face Profiles
GenericName=Face Authentication
Comment=Enroll and manage infrared face authentication profiles
Comment[de]=Gesichts-Authentifizierungsprofile verwalten
Exec=namtor-enroll-wizard
Icon=org.namtor.Wizard
Terminal=false
Categories=Settings;Security;GTK;GNOME;
Keywords=face;authentication;biometric;iris;infrared;login;security;namtor;
StartupNotify=true
StartupWMClass=org.namtor.Wizard
X-GNOME-UsesNotifications=false
