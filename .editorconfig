root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.rs]
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 88

[*.{toml,yml,yaml,json}]
indent_size = 2

[*.{sh,bash}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{qml,cpp,h}]
indent_size = 4

# Binary fixtures: never reformat.
[fixtures/**]
insert_final_newline = false
trim_trailing_whitespace = false
